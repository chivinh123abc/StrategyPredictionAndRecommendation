# ==============================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG (FILE MẪU)
# Hãy sao chép file này thành .env và điền các giá trị thực tế của bạn
# ==============================================================================

# 1. RIOT GAMES API KEY (Bắt đầu bằng RGAPI-...)
# Lấy mã tại: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-api-key-here

# 2. CẤU HÌNH MÁY CHỦ CÀO DỮ LIỆU
# Các mã hỗ trợ: vn2 (Việt Nam), kr (Hàn Quốc)
ACTIVE_SERVERS=vn2,kr

# 3. SỐ LƯỢNG TRẬN MỤC TIÊU MỖI MÁY CHỦ
TARGET_MATCHES_PER_SERVER=50

# 4. CẤU HÌNH THƯ MỤC GOOGLE DRIVE LƯU TRỮ DỮ LIỆU CHUNG (ORACLE'S ELIXIR)
GOOGLE_DRIVE_FOLDER_ID=1gLSw0RLjBbtaNy0dgnGQDAZOHIgCe-HH

# 5. CẤU HÌNH LỌC GIẢI ĐẤU ESPORTS VÀ NGƯỠNG MẪU TỐI THIỂU (TÙY CHỌN)
# Để trống để lấy toàn bộ giải đấu, hoặc điền: LCK,LCP,LPL
ESPORTS_TARGET_LEAGUES=LCK,LCP,LPL
MIN_MATCHES_THRESHOLD=3000

